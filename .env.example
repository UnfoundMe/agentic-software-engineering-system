# Copy to .env and adjust. .env is git-ignored.
# ---------------------------------------------------------------------------

# --- Postgres superuser (container bootstrap only, never used at runtime) ---
POSTGRES_SUPERUSER_PASSWORD=change_me_local_only
POSTGRES_HOST=localhost
# If you already run a native/local PostgreSQL on this machine, it likely
# owns 5432 and Docker's port mapping will silently connect you to the WRONG
# server (you'll see "password authentication failed" for a role that was
# never yours to begin with). Change this to 5433 (or anything free) if so -
# check with, e.g., `Get-NetTCPConnection -LocalPort 5432` on Windows.
POSTGRES_PORT=5432
POSTGRES_DB=ases

# --- Least-privilege runtime identities (created by `ases db bootstrap`) ----
# ases_control : owns the `control` schema; used by Alembic only (DDL)
# ases_app     : orchestrator runtime; DML only, no DDL, no UPDATE/DELETE on events
# workload_app : agent-generated EF Core; owns `workload_test`, no access to `control`
ASES_CONTROL_PASSWORD=change_me_local_only
ASES_APP_PASSWORD=change_me_local_only
WORKLOAD_APP_PASSWORD=change_me_local_only

# --- Redis (workload only; never used by the kernel) -----------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- LLM provider ----------------------------------------------------------
# replay  : deterministic, offline, no key required  (DEFAULT)
# record  : calls Anthropic and writes cassettes
# live    : calls Anthropic, no cassette written
# mock    : synthetic responses, for unit tests
ASES_LLM_MODE=replay
ANTHROPIC_API_KEY=

# --- Budgets (enforced at the entry gate; a run safe-stops when exhausted) --
ASES_MAX_TOKENS_PER_RUN=2000000
ASES_MAX_USD_PER_RUN=25.00
ASES_MAX_WALLCLOCK_SECONDS=3600
ASES_MAX_REPAIR_ITERATIONS=3

# --- Observability ---------------------------------------------------------
ASES_LOG_LEVEL=INFO
ASES_OTEL_FILE=runs/traces.otlp.jsonl

# --- Dashboard -------------------------------------------------------------
ASES_WEB_HOST=127.0.0.1
ASES_WEB_PORT=8420
